{
  "id": "/admin",
  "name": "Nitro Admin - Juan Arango Ecommerce",
  "short_name": "Nitro Admin",
  "description": "Panel de juanarangoecommerce.com: contactos, newsletter, formularios y segmentos.",
  "start_url": "/admin/launch.html",
  "scope": "/admin",
  "display": "standalone",
  "background_color": "#0B0D0B",
  "theme_color": "#0B0D0B",
  "lang": "es-CO",
  "orientation": "portrait-primary",
  "icons": [
    { "src": "/icons/admin-192.png", "sizes": "192x192", "type": "image/png" },
    { "src": "/icons/admin-512.png", "sizes": "512x512", "type": "image/png" },
    { "src": "/icons/admin-maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ],
  "shortcuts": [
    { "name": "Contactos", "short_name": "Contactos", "url": "/admin/contactos", "icons": [{ "src": "/icons/admin-192.png", "sizes": "192x192" }] },
    { "name": "Newsletter", "short_name": "Newsletter", "url": "/admin/newsletter", "icons": [{ "src": "/icons/admin-192.png", "sizes": "192x192" }] }
  ]
}
